{
  "name": "vuurtoren-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm i18n:compile && vite",
    "build": "pnpm i18n:compile && tsc -b && vite build",
    "check": "biome check",
    "fix": "biome check --write",
    "test": "pnpm i18n:compare && vitest run",
    "preview": "vite preview",
    "build:browser": "pnpm i18n:compile && node ../scripts/build_browser_assets.mjs && tsc -b && vite build --mode pyodide",
    "preview:browser": "vite preview --mode pyodide",
    "gen:api": "uv run python ../scripts/dump_openapi.py src/lib/openapi.json && node tools/gen-api/gen.mjs src/lib/openapi.json src/lib/api.gen.ts",
    "i18n:compile": "lingui compile --strict && node tools/i18n/message-ids.mjs",
    "i18n:compare": "pnpm i18n:compile && node tools/i18n/compare.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@lingui/core": "^6.12.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "pyodide": "^314.0.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vuurtoren/gen-api": "workspace:*",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26"
  }
}
