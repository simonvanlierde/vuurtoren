{
  "name": "vuurtoren-frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "biome check",
    "fix": "biome check --write",
    "test": "vitest run",
    "preview": "vite preview",
    "build:browser": "node ../scripts/build_browser_assets.mjs && tsc -b && vite build --mode pyodide",
    "preview:browser": "vite preview --mode pyodide",
    "gen:api": "uv run python ../scripts/dump_openapi.py src/lib/openapi.json && node tools/gen-api/gen.mjs src/lib/openapi.json src/lib/api.gen.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "pyodide": "^314.0.7",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vuurtoren/gen-api": "workspace:*",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26"
  }
}
